{
  "name": "vibevault",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "setup": "node scripts/setup.cjs",
    "start": "node scripts/expo.cjs start",
    "android": "node scripts/expo.cjs start --android",
    "ios": "node scripts/expo.cjs start --ios",
    "web": "node scripts/expo.cjs start --web",
    "export:web": "node scripts/expo.cjs export --platform web",
    "typecheck": "tsc --noEmit && tsc -p supabase/functions",
    "lint": "expo lint",
    "test": "jest",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:db",
    "providers:check": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/check-providers.ts",
    "test:db": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test supabase/tests/database.test.ts supabase/tests/refresh.test.ts",
    "e2e": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON e2e/run.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.12",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.22.0",
    "@react-navigation/native": "^7.5.2",
    "@react-navigation/native-stack": "^7.21.1",
    "expo": "~55.0.32",
    "expo-clipboard": "~55.0.17",
    "expo-font": "~55.0.8",
    "expo-linear-gradient": "~55.0.18",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.22",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~55.0.8",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~55.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.22",
    "puppeteer-core": "^24.43.1",
    "typescript": "~5.9.2"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "/src/__tests__/helpers/",
      "/supabase/tests/"
    ]
  }
}
