# Copy to supabase/functions/.env (gitignored), fill in what you have, then:
#   npm run providers:check                                        # tests every key against the real APIs
#   npx supabase@3 secrets set --env-file supabase/functions/.env  # uploads them to your project
# Every service is optional: anything left empty is simply skipped.

# Any long random string; the cron job sends it to refresh-catalog
REFRESH_CRON_SECRET=

# ---------------- Marketplaces (live listings and prices) ----------------

# Flipkart Affiliate API — India. affiliate.flipkart.com → Tools → API Token
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# Amazon Creators API — Amazon's 22 country sites. Associates Central → Tools → Creators API.
# Needs an Associates account with 10 qualified sales in the last 30 days.
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
# 3.1 = North America, 3.2 = Europe / Middle East / India, 3.3 = Far East (shown with your credentials)
AMAZON_CREATORS_CREDENTIAL_VERSION=3.2
# Your associate tag for each country site you joined, e.g. IN:yourtag-21,US:yourtag-20,GB:yourtag-21
AMAZON_PARTNER_TAGS=

# eBay Browse API — new and pre-owned. developer.ebay.com → Application Keysets → Production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Shopper countries to serve (items must deliver there); NEW and/or USED listings
EBAY_MARKETS=IN,US,GB,DE,FR,IT,ES,AU,CA
EBAY_CONDITIONS=USED
# Optional: eBay Partner Network campaign id for affiliate links
EBAY_CAMPAIGN_ID=

# AliExpress Affiliate API — ships worldwide. portals.aliexpress.com (tracking id) +
# openservice.aliexpress.com (create an app with the Affiliates API)
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
ALIEXPRESS_MARKETS=IN,US,GB,DE,FR,ES,IT,NL,PL,AU,CA,BR,MX,JP,KR,AE,SA,SG

# Etsy Open API v3 — handmade and vintage, from shops in each country. developer.etsy.com → Your Apps
ETSY_API_KEY=
ETSY_SHARED_SECRET=
ETSY_MARKETS=US,GB,CA,AU,DE,FR,IN

# Google Shopping via SerpApi (paid; one search = one credit) — prices from stores without
# their own API (Myntra, Ajio, Zalando, ASOS, …). serpapi.com → Dashboard → API key
SERPAPI_API_KEY=
SERPAPI_MARKETS=IN,US,GB

# ---------------- Price history archive ----------------

# Keepa (paid) — imports up to a year of past Amazon prices for Amazon listings, so
# predictions can learn from past sale seasons. keepa.com → API access
KEEPA_API_KEY=

# ---------------- Coupons & offers (only valid, in-date offers are shown) ----------------

# Flipkart offers use the Flipkart keys above.

# Cuelinks (India) — cuelinks.com → Profile → API key (scopes read:offers, read:campaigns)
CUELINKS_API_KEY=

# Admitad (global) — admitad.com → your app's client id/secret, and your ad space (website) id
ADMITAD_CLIENT_ID=
ADMITAD_CLIENT_SECRET=
ADMITAD_WEBSITE_ID=
ADMITAD_MARKETS=IN,US,GB,DE,FR,ES,IT,BR,MX,PL

# Awin (UK, Europe, US, Australia) — ui.awin.com → API credentials; your publisher id
AWIN_API_TOKEN=
AWIN_PUBLISHER_ID=
AWIN_MARKETS=GB,US,DE,FR,IT,ES,NL,AU
