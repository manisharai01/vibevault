# Copy to supabase/functions/.env (gitignored), fill in, then:
#   npm run providers:check                                   # test the keys locally
#   npx supabase secrets set --env-file supabase/functions/.env   # upload to your project

# Flipkart Affiliate API (affiliate.flipkart.com → Tools → API Token)
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# eBay Developer Program (developer.ebay.com → Application Keysets → Production)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Marketplace to search and the country items must ship to
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_DELIVERY_COUNTRY=IN
# Optional: eBay Partner Network campaign id for affiliate links
EBAY_CAMPAIGN_ID=

# Any long random string; the daily cron job sends it to refresh-catalog
REFRESH_CRON_SECRET=
