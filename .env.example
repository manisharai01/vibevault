# VibeVault app configuration. Copy to .env (gitignored) and fill in from
# Supabase → Project Settings → API. Both values are embedded in the app at
# build time; the anon/publishable key is public by design and can only read
# the catalogue (row-level security). Never put the service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
